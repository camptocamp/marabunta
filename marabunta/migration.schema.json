{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marabunta migration.yml",
  "type": "object",
  "required": ["migration"],
  "additionalProperties": false,
  "properties": {
    "migration": {
      "type": "object",
      "required": ["versions"],
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install_command": {
              "type": "string",
              "default": "odoo"
            },
            "install_args": {
              "type": "string"
            },
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {"type": "string"},
                "ignore_if": {"type": "string"},
                "stop_on_failure": {"type": "boolean", "default": true}
              }
            }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["version"],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(\\d+\\.\\d+\\.\\d+(\\.\\d+\\.\\d+)?|setup)$"
              },
              "backup": {"type": "boolean"},
              "override_translations": {"type": "boolean"},
              "operations": {"$ref": "#/$defs/operations"},
              "addons": {"$ref": "#/$defs/addons"},
              "modes": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operations": {"$ref": "#/$defs/operations"},
                    "addons": {"$ref": "#/$defs/addons"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre": {"type": "array", "items": {"type": "string"}},
        "post": {"type": "array", "items": {"type": "string"}}
      }
    },
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upgrade": {"type": "array", "items": {"type": "string"}},
        "remove": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
